# FinSight API environment
PORT=5000

DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password
DB_SCHEMA=finance

# Use verified TLS whenever your database provider supports it.
DB_SSL=true
# Optional PEM-encoded CA for a provider using a private certificate authority.
# DB_SSL_CA=

# Generate these with: node tools/generate-workspace-credentials.mjs
# Never commit the generated values or your workspace password.
FINSIGHT_PASSWORD_HASH=
FINSIGHT_SESSION_SECRET=
# Local development only. This is ignored on Vercel and in production.
# FINSIGHT_DISABLE_AUTH=true

LOG_LEVEL=info
