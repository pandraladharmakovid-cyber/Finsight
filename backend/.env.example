# FinSight API environment
PORT=5000

DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password
DB_SCHEMA=finance

# Use verified TLS whenever your database provider supports it.
DB_SSL=true
# Optional PEM-encoded CA for a provider using a private certificate authority.
# DB_SSL_CA=

LOG_LEVEL=info
